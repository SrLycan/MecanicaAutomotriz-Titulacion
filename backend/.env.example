# SS SWAP - Ejemplo de configuracion del backend (SIN secretos reales).
# Copia este archivo como .env y completa los valores. Nunca subas el .env a git.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ── Base de datos (PostgreSQL local o Supabase) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_base
DB_USER=postgres
DB_PASSWORD=cambia-esto
DB_SSL=false
# true = aplica migrations.sql al arrancar (BD local). En Supabase dejar en false
# y correr el SQL a mano (ver LEEME, Sprint 22).
RUN_MIGRATIONS=false

JWT_SECRET=una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ── Multiempresa (Sprint 22) ──
# Empresa duena de la pagina web publica (slug de la tabla empresas).
EMPRESA_PUBLICA=ss-swap
# Rol sin privilegios con el que se ejecutan las consultas de cada empresa
# (lo crea la migracion). Solo cambiarlo si se renombra el rol en la BD.
# DB_APP_ROLE=ssswap_app

# ── Respaldos ──
# Carpeta de respaldos: fuera de lo que sirve el frontend y fuera de git.
# Por defecto <proyecto>/respaldos.
# BACKUP_DIR=C:\ruta\protegida\respaldos
# Respaldo diario dentro del servidor (true/false) y hora (0-23).
BACKUP_AUTO=false
BACKUP_HOUR=3
# Retencion: dias, y cantidad minima de respaldos que SIEMPRE se conservan.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7
# Clave para cifrar los respaldos (AES-256-GCM). Guardala tambien FUERA del
# servidor: sin ella los respaldos cifrados no se pueden restaurar.
# BACKUP_ENCRYPTION_KEY=una-frase-larga-solo-para-respaldos
# Motor: auto (pg_dump si existe, si no json) | pg_dump | json
BACKUP_ENGINE=auto
# Carpeta de los binarios de PostgreSQL si pg_dump no esta en el PATH.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin

# Prueba de restauracion: servidor donde se crea la base TEMPORAL
# ssswap_prueba_restauracion (por defecto, el mismo de DB_HOST). Con Supabase
# apuntar a un PostgreSQL local o de pruebas: Supabase no permite crear bases.
# RESTORE_TEST_HOST=localhost
# RESTORE_TEST_PORT=5432
# RESTORE_TEST_USER=postgres
# RESTORE_TEST_PASSWORD=cambia-esto

# ── Opcional: chatbot y bitacora ──
# GEMINI_API_KEY=
# GEMINI_MODEL=
# MONGO_URI=
# MONGO_DB_NAME=
