# ============================================================
# SS SWAP Backend - Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# Servidor
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SS SWAP_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# JWT
JWT_SECRET=SS SWAP_jwt_secret_cambia_esto_en_produccion
JWT_EXPIRES_IN=8h

# CORS - Origen del frontend
CORS_ORIGIN=http://localhost:3000

# SWAPBot (Google Gemini - plan gratuito)
# Consigue tu API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash-lite
# Limite de mensajes con IA por dia (cuidar la cuota gratuita).
# Revisa el limite real vigente para tu cuenta en Google AI Studio;
# 1000 es el valor documentado en el plan de titulacion.
GEMINI_DAILY_QUOTA=5000
